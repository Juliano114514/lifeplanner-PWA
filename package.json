{
  "name": "lifeplanner-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.2.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "check:sql": "node scripts/check-sql.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "db:remote": "wrangler d1 migrations apply DB --config wrangler.jsonc --remote"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
