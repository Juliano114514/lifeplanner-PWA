{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeplanner-pwa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lifeplanner",
    "database_id": "0b35fc0d-449e-4aa1-adcd-f8afa79517ae",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "PLACE_SEARCH_ENABLED": "true",
    "PLACE_SEARCH_URL": "https://nominatim.openstreetmap.org/search",
    "APP_ORIGIN": "https://lifeplanner-pwa.juliano114514.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23liOjnxo1fUDGLeKb",
    "ALLOWED_GITHUB_IDS": "116798367,326411123",
    "APP_TIME_ZONE": "Asia/Shanghai"
  }
}
